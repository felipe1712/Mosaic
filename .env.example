APP_NAME="MosaicStudio Pro"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ========================================================
# DATABASE CONFIGURATION
# Production / Docker: pgsql (PostgreSQL 16)
# Local Development: mysql or pgsql
# ========================================================
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mosaic
DB_USERNAME=postgres
DB_PASSWORD=postgres_secret

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

# Queue Driver: 'sync' for direct execution, 'redis' or 'database'
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=mosaic_cache_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="studio@mosaicpro.local"
MAIL_FROM_NAME="${APP_NAME}"

# ========================================================
# HIGH-PERFORMANCE 32 GB RAM HARDWARE TUNING
# PHP Directives:
# memory_limit = 8G
# upload_max_filesize = 500M
# post_max_size = 2G
# max_execution_time = 600
# ========================================================
PHP_MEMORY_LIMIT=8G
PHP_POST_MAX_SIZE=2G
PHP_UPLOAD_MAX_FILESIZE=500M
PHP_MAX_EXECUTION_TIME=600

# Path to Python 3 with Pillow, numpy, and scipy installed
PYTHON_BIN=python3

VITE_APP_NAME="${APP_NAME}"
